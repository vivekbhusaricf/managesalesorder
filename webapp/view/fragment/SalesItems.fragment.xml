<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
>
    <Table
        id="idSalesOrdersItems"
        items="{salesDetailsModel>/ToLineItems/results}"
    >
        <columns>
            <Column>
                <header>
                    <Text text="Product ID" />
                </header>
            </Column>

            <Column>
                <Text text="Net Amount" />
            </Column>

            <Column>
                <Text text="Quantity" />
            </Column>

            <Column>
                <Text text="Quantity Unit" />
            </Column>
        </columns>

        <ColumnListItem>
            <cells>
                <ObjectIdentifier title="{salesDetailsModel>ProductID}" />
                <Text text="{salesDetailsModel>NetAmount}" />
                <Text text="{salesDetailsModel>Quantity}" />
                <Text text="{salesDetailsModel>QuantityUnit}" />
            </cells>
        </ColumnListItem>
    </Table>
</core:FragmentDefinition>
